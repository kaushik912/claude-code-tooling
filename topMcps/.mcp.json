{
  "mcpServers": {
    "mysql": {
      "command": "npx",
      "args": [
        "-y",
        "@benborla29/mcp-server-mysql"
      ],
      "env": {
        "MYSQL_HOST": "localhost",
        "MYSQL_PORT": "3306",
        "MYSQL_USER": "root",
        "MYSQL_PASS": "${MYSQL_PWD}",
        "MYSQL_DB": "calendar_db"
      }
    },
    "Atlassian": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote@latest",
        "https://mcp.atlassian.com/v1/mcp/authv2"
      ]
    },
    "codebase-memory-mcp": {
      "type": "stdio",
      "command": "/home/kaush/.local/bin/codebase-memory-mcp",
      "args": [],
      "env": {
        "CBM_ALLOWED_ROOT": "/home/kaush/github_projs/claude-code-tooling/topMcps"
      }
    },
    "github": {
      "type": "stdio",
      "command": "java",
      "args": [
        "-jar",
        "/home/kaush/github_projs/enterprise-repos/gh_mcp_server/build/libs/gh_mcp_server.jar"
      ],
      "env": {}
    }
  }
}